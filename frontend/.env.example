# Google Maps JavaScript API Key (Opsional - Aplikasi telah menggunakan OpenStreetMap & Satelit Esri 100% Gratis)
VITE_GOOGLE_MAPS_API_KEY=

# Backend API URL (Opsional)
# Kosongkan jika frontend dan backend di-deploy bersamaan pada satu domain / container.
# Isi dengan URL backend jika di-deploy terpisah (misal di Vercel/Netlify menuju backend Railway/Render/VPS):
# Contoh: VITE_API_URL=https://api.georesidence.itera.ac.id
VITE_API_URL=
